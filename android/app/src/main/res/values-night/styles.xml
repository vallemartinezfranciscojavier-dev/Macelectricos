<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema aplicado a la ventana de Android mientras el proceso inicia
         cuando el Modo Oscuro del sistema está encendido -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema aplicado a la ventana de Android en cuanto el proceso ha iniciado.
         Determinado el color de la ventana mientras la UI de Flutter se inicializa. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>